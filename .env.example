# PostgreSQL (required for form storage and /api/health)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Canonical site URL used for metadata, sitemap, and JSON-LD.
# Set this to the production origin, e.g. https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web3Forms access key for service enquiry and theme support emails.
# Create a key at https://web3forms.com/
# The key is used on the server. NEXT_PUBLIC_ is accepted as a fallback
# because Web3Forms documents browser-side keys, but it is not a private secret.
WEB3FORMS_ACCESS_KEY=
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
